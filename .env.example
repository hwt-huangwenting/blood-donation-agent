# ==================== Agent 服务自身 ====================
AGENT_PORT=8000

# ==================== LLM / Embedding（OpenAI 兼容协议，可切换平台） ====================
# 智谱（免费：glm-4-flash + embedding-3）：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
#   LLM_MODEL=glm-4-flash
#   EMBEDDING_MODEL=embedding-3
# 阿里云百炼（付费：qwen-plus + text-embedding-v3）：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#   EMBEDDING_MODEL=text-embedding-v3
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024

# ==================== Agent 侧 PostgreSQL（只放向量 + 运行日志） ====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blood_agent

# ==================== 业务系统（Express 后端） ====================
# 你的业务系统地址（示例为本地 3100 端口）
BIZ_API_BASE=http://localhost:3100
# 与业务系统一致，用于校验前端带来的用户登录态
JWT_SECRET=
# 服务间调用凭证，需与业务系统一致
AGENT_SERVICE_TOKEN=

# ==================== 运行开关 ====================
# 业务系统接口不可用时置 true，用 mock 数据独立运行（公开演示默认开启）
USE_MOCK_BIZ=true
# 临时开关：置 true 时用确定性假向量（字符 unigram+bigram 哈希）跳过 Embedding 接口，
# 仅用于在 Embedding 配额不可用时验证工程链路，检索结果不是真实语义相似度。
# 正常情况保持 false；填入可用 LLM_API_KEY 后改回 false 并重新灌库。
USE_FAKE_EMBEDDING=false
# 检索最低相似度阈值，低于该分数的条文不返回
RETRIEVAL_SCORE_THRESHOLD=0.35
